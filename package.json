{
  "name": "wex-agent-electron",
  "version": "0.1.0",
  "description": "Electron desktop version of wex-agent with the same agentic loop and tool-calling core",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "diff": "^8.0.4",
    "dotenv": "^17.4.1",
    "glob": "^11.0.2",
    "openai": "^6.34.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shell-quote": "^1.8.3",
    "strip-ansi": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.2"
  },
  "packageManager": "pnpm@10.23.0"
}
